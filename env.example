GEMINI_API_KEY=your_ai_studio_key_here
VISION_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
DATA_DIR=data
MAX_REQUESTS_PER_RUN=300
# Weather location for Open-Meteo (default Bengaluru)
LAT=12.97
LON=77.59
# Set true ONLY after you moved to a paid, no-training Gemini config AND give consent in the app.
ALLOW_PERSON_PHOTOS=false
# Public HF Space used for try-on. A public Space is a third party: use a stock model photo, not your own.
TRYON_SPACE=yisol/IDM-VTON
TRYON_QA_THRESHOLD=3
